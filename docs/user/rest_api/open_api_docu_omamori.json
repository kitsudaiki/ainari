    "/v1alpha/project/{project_id}/export/internal": {
      "post": {
        "tags": [
          "project"
        ],
        "summary": "Export project",
        "description": "Export the secrets and public-keys of a project for a backup.\\\n\\\nThe payloads of the secrets never leave the omamori in plain text: each payload is wrapped with\\\n`wrap_key` (AES-256-GCM with a new nonce and the UUID of the secret as additional data). The\\\n`wrap_key` is only used for this request and is never stored or logged. The secrets of backups are\\\nnot exported, except the ones of the backup `backup_uuid`, which encrypt its disks. Users, which are\\\nnot admin, can only export their own project.\\\n\\\nThis is an internal call, which is protected by the internal api-key.",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "title": "String",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
