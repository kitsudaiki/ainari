            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_by": {
            "type": "string"
          },
          "uuid": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "PublicKeyUploadReq": {
        "title": "PublicKeyUploadReq",
        "type": "object",
        "required": [
          "name",
          "public_key"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 127,
            "minLength": 4
          },
          "public_key": {
            "description": "The ssh-public-key in its one-line openssh-representation. The fingerprint is not provided here, but calculated from this key by the server.",
            "type": "string",
            "maxLength": 4096,
            "minLength": 8
          }
        }
      },
      "ReadyResp": {
        "title": "ReadyResp",
        "type": "object",
        "required": [
          "api"
        ],
        "properties": {
          "api": {
            "type": "boolean"
          }
        }
      },
      "Secret": {
        "description": "Wrapper around a string, which must not be leaked into logs or error-messages.\n\n`Debug` and `Display` both print `***` instead of the content, so a secret stays hidden even when it is part of a bigger struct, which is logged as a whole. The content is only reachable through `reveal`, which makes every intended access visible at the call-site.",
        "type": "string"
      },
      "SecretBasicResp": {
        "type": "object",
        "required": [
          "name",
          "uuid"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "uuid": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SecretCreateReq": {
        "title": "SecretCreateReq",
        "type": "object",
        "required": [
          "name",
          "secret_payload"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 127,
            "minLength": 4
          },
          "secret_payload": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Secret"
              }
            ],
            "maxLength": 4096,
            "minLength": 8,
            "maxItems": 4096,
            "minItems": 8
          }
        }
      },
      "SecretGenerateReq": {
        "title": "SecretGenerateReq",
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 127,
            "minLength": 4
          }
        }
      },
      "SecretListResp": {
