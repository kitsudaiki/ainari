        ],
        "summary": "Import project",
        "description": "Import the secrets and public-keys of a project from a backup.\\\n\\\nThe payloads of the secrets are unwrapped with `wrap_key` and stored encrypted by the omamori\\\nagain. The `wrap_key` is only used for this request and is never stored or logged. A wrong\\\n`wrap_key` or a changed payload is rejected with `400`, before anything is changed.\\\n\\\nThe resources keep their UUIDs, unless the `id_map` gives them a new one, which is also applied to\\\nthe resources, which own the secrets. A UUID, which is used by another project, is rejected with\\\n`409`. An existing secret or public-key of the project with the same UUID is rejected with `409`,\\\nunless `force` is set, which overwrites it. All conflicts are checked, before anything is changed. The quota of the project is not checked here. Users, which are not\\\nadmin, can only import into their own project.\\\n\\\nThis is an internal call, which is protected by the internal api-key.",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "title": "String",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OmamoriProjectImportReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OmamoriProjectImportResp"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "409": {
            "description": "Conflict with existing resources"
          },
          "500": {
            "description": "Internal error"
          }
        },
        "deprecated": false,
        "security": [
          {
            "user_context": []
          }
        ]
      }
    }
