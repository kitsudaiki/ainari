        ],
        "properties": {
          "secrets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SecretBasicResp"
            }
          }
        }
      },
      "SecretResp": {
        "title": "SecretResp",
        "type": "object",
        "required": [
