    "/v1alpha/token": {
      "put": {
        "tags": [
          "auth"
        ],
        "summary": "Renew Token",
        "description": "Create a new access-token for the user of the current token, in order to extend the session.\\\n\\\nWith `project_id` in the body, the new token is created for this project instead of the project of the current token, which switches the project without a new login. The user must be assigned to the project. The role within the project is read again in both cases, so changes of the role are applied with the renewal.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRenewReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "title": "UserTokenResp",
                  "type": "object",
                  "required": [
                    "access_token",
                    "expires",
                    "token_type"
                  ],
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "expires": {
                      "type": "integer",
                      "format": "uint64",
                      "minimum": 0.0
                    },
                    "token_type": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal error"
          }
        },
        "deprecated": false,
        "security": [
          {
            "user_context": []
          }
        ]
      },
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Create Token",
        "description": "Create a new access-token for the given user-credentials. The token is scoped to the project given by the optional `project_id`, or to the default-project of the user, if not set. The user must be assigned to the project.",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserTokenResp"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal error"
          }
        },
        "deprecated": false
      },
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Validate Token",
        "description": "Validate the access-token of the request.\\\n\\\nThe check itself is done by the middleware, so a successful response means that\\\nthe token is valid, and the content of the token is returned.",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
