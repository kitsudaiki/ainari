    "/v1alpha/token": {
      "put": {
        "tags": [
          "auth"
        ],
        "summary": "Renew Token",
        "description": "Create a new access-token for the user of the current token,\\\n\\\nin order to extend the session.",
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "title": "UserTokenResp",
                  "type": "object",
                  "required": [
                    "access_token",
                    "expires",
                    "token_type"
                  ],
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "expires": {
                      "type": "integer",
                      "format": "uint64",
                      "minimum": 0.0
                    },
                    "token_type": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal error"
          }
        },
        "deprecated": false,
        "security": [
          {
            "user_context": []
          }
        ]
      },
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Create Token",
        "description": "Create a new access-token for the given user-credentials.",
