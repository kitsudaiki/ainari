  "components": {
    "schemas": {
      "AuditLogAddInternalReq": {
        "title": "AuditLogAddInternalReq",
        "description": "Request of the other components to add an entry to the audit-log of omikuji.",
        "type": "object",
        "required": [
          "component_name",
          "endpoint",
          "host_name",
          "project_id",
          "request_type",
          "user_id"
        ],
        "properties": {
          "component_name": {
            "description": "Name of the component, which reports the entry, like `hanami`",
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          },
          "endpoint": {
            "description": "Endpoint, which was called by the audited request",
            "type": "string",
            "maxLength": 1024,
            "minLength": 1
          },
          "host_name": {
            "description": "Host, where the entry was created",
            "type": "string",
            "maxLength": 256
          },
          "project_id": {
            "description": "Project, which is related to the entry. Empty, if the entry belongs to no project.",
            "type": "string",
            "maxLength": 256
          },
          "request_type": {
            "description": "Type of the audited request, like `POST`",
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          },
          "user_id": {
            "description": "User, which is related to the entry. Empty, if the entry was not caused by a user.",
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "AuditLogListResp": {
