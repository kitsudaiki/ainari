    "/v1alpha/error_log/internal": {
      "post": {
        "tags": [
          "error_log"
        ],
        "summary": "Add error-message (internal)",
        "description": "Add a new error-message of another component to the central error-log.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorLogAddInternalReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "title": "ErrorLogResp",
                  "description": "Single entry of the error-log.",
                  "type": "object",
                  "required": [
                    "component_name",
                    "created_at",
                    "host_name",
                    "message",
                    "project_id",
                    "user_id",
                    "uuid"
                  ],
                  "properties": {
                    "component_name": {
                      "type": "string"
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "host_name": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "project_id": {
                      "type": "string"
                    },
                    "user_id": {
                      "type": "string"
                    },
                    "uuid": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal error"
          }
        },
        "deprecated": false
      }
    },
    "/v1alpha/error_log/admin": {
      "get": {
        "tags": [
          "error_log"
        ],
        "summary": "List error-messages",
        "description": "List the error-messages of the central error-log, sorted by their creation-time with the newest first. They can be filtered by the optional query-parameters `project_id`, `user_id` and `host_name`, and the number of returned entries can be limited by `limit`, which defaults to 100. This can only be done by an admin.",
        "parameters": [
          {
            "name": "host_name",
            "in": "query",
            "description": "Only list the entries of this host",
            "required": false,
            "schema": {
              "description": "Only list the entries of this host",
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of entries to return, the newest first. Defaults to 100.",
            "required": false,
            "schema": {
              "description": "Maximum number of entries to return, the newest first. Defaults to 100.",
              "type": "integer",
              "format": "uint32",
              "maximum": 10000.0,
              "minimum": 1.0,
              "nullable": true
            }
          },
          {
            "name": "project_id",
            "in": "query",
            "description": "Only list the entries of this project",
            "required": false,
            "schema": {
              "description": "Only list the entries of this project",
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "user_id",
            "in": "query",
            "description": "Only list the entries of this user",
            "required": false,
            "schema": {
              "description": "Only list the entries of this user",
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorLogListResp"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal error"
          }
        },
        "deprecated": false,
        "security": [
          {
            "user_context": []
          }
        ]
      }
    },
