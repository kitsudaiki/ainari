    "/v1alpha/virtual_machine/{virtual_machine_uuid}/snapshot_save": {
      "post": {
        "tags": [
          "task"
        ],
        "summary": "Create new snapshot-save-task",
        "description": "Create a new task, which saves the root-disk of a virtual_machine as new snapshot.\\\n\\\nThe snapshot is registered in ryokan as image, which is marked as snapshot, before the task is\\\nqueued, so the image-quota of the project is checked immediately. The task encrypts the root-disk\\\nand uploads it into the onsen. With `secret_uuid`, the snapshot is encrypted with this already\\\nexisting secret of the omamori, instead of a new generated secret.\\\n\\\nThe virtual_machine is only paused, while its root-disk is copied. Data, which was written shortly\\\nbefore, can still be in the memory of the virtual_machine and is then missing in the snapshot.\\\nRun `sync` inside the virtual_machine right before creating the snapshot.",
        "parameters": [
          {
            "name": "virtual_machine_uuid",
            "in": "path",
            "required": true,
            "schema": {
              "title": "Uuid",
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskSnapshotSaveReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "title": "TaskResp",
                  "type": "object",
                  "required": [
                    "created_by",
                    "description",
                    "messages",
                    "state",
                    "task_type",
                    "uuid"
                  ],
                  "properties": {
                    "created_by": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "finished_at": {
                      "type": "string",
                      "format": "date-time",
                      "nullable": true
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "queued_at": {
                      "type": "string",
                      "format": "date-time",
                      "nullable": true
                    },
                    "started_at": {
                      "type": "string",
                      "format": "date-time",
                      "nullable": true
                    },
                    "state": {
                      "$ref": "#/components/schemas/TaskState"
                    },
                    "task_type": {
                      "$ref": "#/components/schemas/TaskType"
                    },
                    "uuid": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
