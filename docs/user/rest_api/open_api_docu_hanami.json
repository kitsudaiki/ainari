        ]
      },
      "delete": {
        "tags": [
          "virtual_machine"
        ],
        "summary": "Delete virtual_machine",
        "description": "Delete a virtual_machine.\\\n\\\nIt is deleted on its sakura-host in the background. A watcher releases its cores, memory and\\\ndisk-space on the host, as soon as the sakura-host has finished the deletion. Its metadata is removed from the database, the\\\nproxy, which is connected to it, is deleted on the torii and the routes from and\\\nto the virtual_machine are removed from the gateways of its network.",
        "parameters": [
          {
            "name": "virtual_machine_uuid",
            "in": "path",
            "required": true,
            "schema": {
              "title": "Uuid",
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
