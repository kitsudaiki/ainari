    "/v1alpha/floating_ip": {
      "post": {
        "tags": [
          "floating_ip"
        ],
        "summary": "Create new floating_ip",
        "description": "Create new floating_ip.\\\n\\\nThe floating ip-address is only reserved and not attached to any virtual_machine. If no\\\nfloating ip-address is requested, a free one is selected. If a virtual_machine is given, the\\\nfloating ip-address is attached to it directly. If this attach fails, the reservation is\\\nreleased again.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FloatingIpCreateReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "title": "FloatingIpResp",
                  "type": "object",
                  "required": [
                    "created_at",
                    "created_by",
                    "floating_ip",
                    "updated_at",
                    "updated_by",
                    "uuid"
                  ],
                  "properties": {
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "created_by": {
                      "type": "string"
                    },
                    "floating_ip": {
                      "type": "string",
                      "format": "ipv4"
                    },
                    "internal_ip": {
                      "description": "Internal IP-address of the attached virtual_machine. Not set, if the floating IP-address is detached.",
                      "type": "string",
                      "format": "ipv4",
                      "nullable": true
                    },
                    "network_uuid": {
                      "description": "Network of the attached virtual_machine. Not set, if the floating IP-address is detached.",
                      "type": "string",
                      "format": "uuid",
                      "nullable": true
                    },
                    "updated_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updated_by": {
                      "type": "string"
                    },
                    "uuid": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
