    "/v1alpha/virtual_machine": {
      "post": {
        "tags": [
          "virtual_machine"
        ],
        "summary": "Reserve new virtual_machine",
        "description": "Reserve a new virtual_machine together with its address within the given network.\\\n\\\nThe virtual_machine is placed on a random sakura-host, which has enough free cores, memory and\\\ndisk-space for it. The image and the public-key are not set here, but by the following\\\ncreate-call.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VirtualMachineCreateReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "title": "VirtualMachineResp",
                  "type": "object",
                  "required": [
                    "created_at",
                    "created_by",
                    "disk_size",
                    "image_uuid",
                    "internal_ip",
                    "memory_size",
                    "name",
                    "network_uuid",
                    "number_of_cores",
                    "torii_port",
                    "updated_at",
                    "updated_by",
                    "uuid",
                    "vm_state"
                  ],
                  "properties": {
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "created_by": {
                      "type": "string"
                    },
                    "disk_size": {
                      "description": "size of the disk of the virtual_machine in GiB",
                      "type": "integer",
                      "format": "int64"
                    },
                    "image_uuid": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "internal_ip": {
                      "type": "string",
                      "format": "ipv4"
                    },
                    "memory_size": {
                      "description": "memory of the virtual_machine; in bytes from sakura, in MiB from hanami",
                      "type": "integer",
                      "format": "int64"
                    },
                    "name": {
                      "type": "string"
                    },
                    "network_uuid": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "number_of_cores": {
                      "type": "integer",
                      "format": "int32"
                    },
                    "torii_port": {
                      "type": "integer",
                      "format": "uint16",
                      "minimum": 0.0
                    },
                    "updated_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updated_by": {
                      "type": "string"
                    },
                    "uuid": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "vm_state": {
                      "description": "Power-state of the virtual_machine: RESERVED, CREATED, RUNNING, STOPPED, RESTORING or ERROR",
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "409": {
            "description": "Conflict with existing resources"
          },
          "500": {
            "description": "Internal error"
          }
        },
        "deprecated": false,
        "security": [
          {
            "user_context": []
          }
        ]
      },
