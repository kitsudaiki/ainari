    "/v1alpha/floating_ip/{floating_ip_uuid}/attach": {
      "put": {
        "tags": [
          "floating_ip"
        ],
        "summary": "Attach floating_ip",
        "description": "Attach a floating_ip to a virtual_machine.\\\n\\\nThe network and the internal ip-address of the virtual_machine are read from the database and\\\nthe NAT of the floating ip-address is registered in the torii. A floating_ip can only be\\\nattached to one virtual_machine and a virtual_machine can only have one floating_ip.",
        "parameters": [
          {
            "name": "floating_ip_uuid",
            "in": "path",
            "required": true,
            "schema": {
              "title": "Uuid",
