    "/v1alpha/image/internal": {
      "post": {
        "tags": [
          "image"
        ],
        "summary": "Initialize new image",
        "description": "Initialize a new image.\\\n\\\nPrepares the database-entry and the onsen, before the files are uploaded. Sakura uses this to\\\nstore the root-disk of a virtual_machine as snapshot, which is marked by `is_snapshot`.\\\n\\\nThis is an internal call, which is protected by the internal api-key.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImageInitReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "title": "ImageInternalResp",
                  "type": "object",
                  "required": [
                    "created_at",
                    "created_by",
                    "file_path",
                    "is_snapshot",
                    "name",
                    "onsen_address",
                    "secret_uuid",
                    "updated_at",
                    "updated_by",
                    "uuid"
                  ],
                  "properties": {
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "created_by": {
                      "type": "string"
                    },
                    "file_path": {
                      "type": "string"
                    },
                    "is_snapshot": {
                      "type": "boolean"
                    },
                    "name": {
                      "type": "string"
                    },
                    "onsen_address": {
                      "type": "string"
                    },
                    "secret_uuid": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "updated_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updated_by": {
                      "type": "string"
                    },
                    "uuid": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Requested object not found"
          },
          "409": {
            "description": "Conflict with existing resources"
          },
          "500": {
            "description": "Internal error"
          }
        },
        "deprecated": false,
        "security": [
          {
            "user_context": []
          }
        ]
      }
    },
