  "components": {
    "schemas": {
      "Count": {
        "title": "Count",
        "type": "object",
        "required": [
          "number_of_items"
        ],
        "properties": {
          "number_of_items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0.0
          }
        }
      },
      "HostBasicResp": {
        "type": "object",
        "required": [
          "host_address",
          "name",
          "uuid"
        ],
        "properties": {
          "host_address": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "uuid": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "HostCreateReq": {
        "title": "HostCreateReq",
        "type": "object",
        "required": [
          "deleted_uuids",
          "host_address",
          "name",
          "registration_key"
        ],
        "properties": {
          "deleted_uuids": {
            "$ref": "#/components/schemas/UuidList"
          },
          "host_address": {
            "type": "string",
            "maxLength": 127,
            "minLength": 4
          },
          "name": {
            "type": "string",
            "maxLength": 127,
            "minLength": 4
          },
          "registration_key": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Secret"
              }
            ],
            "maxLength": 127,
            "minLength": 4,
            "maxItems": 127,
            "minItems": 4
          }
        }
      },
      "HostListResp": {
        "title": "HostListResp",
        "type": "object",
        "required": [
          "hosts"
        ],
        "properties": {
          "hosts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HostBasicResp"
            }
          }
        }
      },
      "HostResp": {
        "title": "HostResp",
        "type": "object",
        "required": [
          "created_at",
          "created_by",
          "host_address",
          "name",
          "updated_at",
          "updated_by",
          "uuid"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "type": "string"
          },
          "host_address": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_by": {
            "type": "string"
          },
          "uuid": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ImageBasicResp": {
        "type": "object",
        "required": [
          "is_snapshot",
          "name",
          "uuid"
        ],
        "properties": {
          "is_snapshot": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "uuid": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ImageInitReq": {
        "title": "ImageInitReq",
        "type": "object",
        "required": [
          "image_type",
          "name",
          "uuid"
        ],
        "properties": {
          "image_type": {
            "type": "string"
          },
          "is_snapshot": {
            "description": "True, if the image is a snapshot of the root-disk of a virtual_machine",
            "default": false,
            "type": "boolean"
          },
          "name": {
            "type": "string",
            "maxLength": 127,
            "minLength": 4
          },
          "uuid": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ImageInternalResp": {
        "title": "ImageInternalResp",
        "type": "object",
        "required": [
          "created_at",
          "created_by",
          "file_path",
          "is_snapshot",
          "name",
          "onsen_address",
          "secret_uuid",
          "updated_at",
          "updated_by",
          "uuid"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "type": "string"
          },
          "file_path": {
            "type": "string"
          },
          "is_snapshot": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "onsen_address": {
            "type": "string"
          },
          "secret_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_by": {
            "type": "string"
          },
          "uuid": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ImageListResp": {
        "title": "ImageListResp",
        "type": "object",
        "required": [
          "images"
        ],
        "properties": {
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImageBasicResp"
            }
          }
        }
      },
      "ImageResp": {
        "title": "ImageResp",
        "type": "object",
        "required": [
          "created_at",
          "created_by",
          "is_snapshot",
          "name",
          "updated_at",
          "updated_by",
          "uuid"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "type": "string"
          },
          "is_snapshot": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_by": {
            "type": "string"
          },
          "uuid": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ReadyResp": {
        "title": "ReadyResp",
        "type": "object",
        "required": [
          "api"
        ],
        "properties": {
          "api": {
            "type": "boolean"
          }
        }
      },
      "Secret": {
        "description": "Wrapper around a string, which must not be leaked into logs or error-messages.\n\n`Debug` and `Display` both print `***` instead of the content, so a secret stays hidden even when it is part of a bigger struct, which is logged as a whole. The content is only reachable through `reveal`, which makes every intended access visible at the call-site.",
        "type": "string"
      },
      "UuidList": {
        "type": "object",
        "required": [
          "list"
        ],
        "properties": {
          "list": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "VersionResp": {
        "title": "VersionResp",
        "type": "object",
        "required": [
          "commit_hash",
          "timestamp",
          "version"
        ],
        "properties": {
          "commit_hash": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "user_context": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "externalDocs": {
    "description": "Find out more about Swagger",
