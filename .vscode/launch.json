{
    "version": "0.2.0",
    // The whole stack runs locally without any container. Torii needs root for its eBPF-datapath
    // and a process can not be debugged, while it gets elevated privileges, so it is not part of
    // the compound as debug-session. Instead it runs as single-node gateway (uplink, floating
    // ip-addresses and TAP-devices of all virtual machines behind one torii) in a task, which asks
    // for the sudo-password in its terminal and is started before all other services.
    // Torii keeps running after the debug-sessions were stopped: terminate the task
    // "Run Torii (single-node)" to stop it, or keep it running for the next start of the compound.
    "compounds": [
        {
            "name": "Ainari Debug",
            "preLaunchTask": "Run Torii (single-node)",
            "stopAll": true,
            "configurations": [
                "Miko Debug Build",
                "Omamori Debug Build",
                "Hanami Debug Build",
                "Ryokan Debug Build",
                "Sakura Debug Build",
                "Onsen Debug Build"
            ],
        },
        {
            "name": "Ainari Release",
            "preLaunchTask": "Run Torii (single-node, release)",
            "stopAll": true,
            "configurations": [
                "Miko Release Build",
                "Omamori Release Build",
                "Hanami Release Build",
                "Ryokan Release Build",
                "Sakura Release Build",
                "Onsen Release Build"
            ],
        }
    ],
    "configurations": [
        {
            "name": "Sakura Debug Build",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/sakura",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "preLaunchTask": "build sakura debug",
            "sourceLanguages": ["rust"],
            "env": {
                "RUST_BACKTRACE": "full",
                "RUST_LOG": "debug,h2=info",
                "INTERNAL_API_KEY": "test-internal-api-key",
                "SAKURA_REGISTRATION_KEY": "sakura-key",
            },
        },
        {
            "name": "Sakura Release Build",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/target/release/sakura",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "preLaunchTask": "build sakura release",
            "sourceLanguages": ["rust"],
            "env": {
                "RUST_LOG": "debug,h2=info",
                "INTERNAL_API_KEY": "test-internal-api-key",
                "SAKURA_REGISTRATION_KEY": "sakura-key",
            },
        },
        {
            "name": "Hanami Debug Build",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/hanami",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "preLaunchTask": "build hanami debug",
            "sourceLanguages": ["rust"],
            "env": {
                "RUST_BACKTRACE": "full",
                "RUST_LOG": "debug",
                "INTERNAL_API_KEY": "test-internal-api-key",
                "SAKURA_REGISTRATION_KEY": "sakura-key",
            },
        },
        {
            "name": "Hanami Release Build",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/target/release/hanami",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
