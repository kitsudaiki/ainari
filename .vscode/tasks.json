{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "build sakura debug",
        "type": "shell",
        "command": "cargo build -p sakura && sleep 5",
        "group": "build",
        "problemMatcher": ["$rustc"]
      },
      {
        "label": "build sakura release",
        "type": "shell",
        "command": "cargo build --release -p sakura && sleep 5",
        "group": "build",
        "problemMatcher": ["$rustc"]
      },
      {
        "label": "build hanami debug",
        "type": "shell",
        "command": "cargo build -p hanami",
        "group": "build",
        "problemMatcher": ["$rustc"]
      },
      {
        "label": "build hanami release",
        "type": "shell",
        "command": "cargo build --release -p hanami",
        "group": "build",
        "problemMatcher": ["$rustc"]
      },
      {
        "label": "build miko debug",
        "type": "shell",
        "command": "cargo build -p miko",
        "group": "build",
        "problemMatcher": ["$rustc"]
      },
      {
        "label": "build miko release",
        "type": "shell",
        "command": "cargo build --release -p miko",
        "group": "build",
        "problemMatcher": ["$rustc"]
      },
      {
        "label": "build ryokan debug",
        "type": "shell",
        "command": "cargo build -p ryokan",
        "group": "build",
        "problemMatcher": ["$rustc"]
      },
      {
        "label": "build ryokan release",
        "type": "shell",
        "command": "cargo build --release -p ryokan",
        "group": "build",
        "problemMatcher": ["$rustc"]
      },
      {
        "label": "build torii debug",
        "type": "shell",
        "dependsOn": "build ebpf payload",
        "command": "cargo build --package torii && sudo setcap cap_sys_admin,cap_net_admin,cap_bpf,cap_ipc_lock,cap_net_raw+eip ${workspaceFolder}/target/debug/torii",
        "group": "build",
        "problemMatcher": ["$rustc"]
      },
      {
        "label": "build torii release",
        "type": "shell",
        "command": "cargo build --release -p torii",
        "group": "build",
        "problemMatcher": ["$rustc"]
      },
      {
        "label": "build omamori debug",
        "type": "shell",
        "command": "cargo build -p omamori",
        "group": "build",
        "problemMatcher": ["$rustc"]
      },
      {
        "label": "build omamori release",
        "type": "shell",
        "command": "cargo build --release -p omamori",
        "group": "build",
        "problemMatcher": ["$rustc"]
      },
      {
        "label": "build onsen debug",
        "type": "shell",
        "command": "cargo build -p onsen && sleep 5",
        "group": "build",
        "problemMatcher": ["$rustc"]
      },
      {
        "label": "build onsen release",
        "type": "shell",
        "command": "cargo build --release -p onsen && sleep 5",
        "group": "build",
        "problemMatcher": ["$rustc"]
      },
      {
        "label": "cargo clippy fix",
        "type": "shell",
        "command": "cargo clippy --all-targets --all-features --fix --allow-dirty --allow-staged",
        "group": "build",
        "problemMatcher": [
            "$rustc"
        ]
      },
      {
        "label": "build ebpf payload",
        "type": "shell",
        "command": "cargo +nightly build --package torii-ebpf --target bpfel-unknown-none -Z build-std=core,panic_abort",
        "problemMatcher": ["$rustc"]
      },
      {
        "label": "build torii complete",
        "type": "shell",
        "dependsOn": "build ebpf payload",
        "command": "cargo build --package torii && sudo setcap cap_sys_admin,cap_net_admin,cap_bpf,cap_ipc_lock,cap_net_raw+eip ${workspaceFolder}/target/debug/torii",
        "problemMatcher": ["$rustc"]
      },
      {
        "label": "Run Torii (Profile A: Debug)",
        "type": "shell",
        "dependsOn": "build ebpf payload",
        "command": "cargo build --package torii && sudo -E RUST_BACKTRACE=full RUST_LOG=debug INTERNAL_API_KEY=key-alpha ${workspaceFolder}/target/debug/torii",
        "problemMatcher": ["$rustc"],
        "group": {
            "kind": "build",
        },
        "presentation": { "reveal": "always", "focus": true, "panel": "shared" }
      },
      {
        "label": "Run Torii (Profile B: Trace)",
        "type": "shell",
        "dependsOn": "build ebpf payload",
        "command": "cargo build --package torii && sudo -E RUST_BACKTRACE=full RUST_LOG=trace INTERNAL_API_KEY=key-beta ${workspaceFolder}/target/debug/torii",
        "problemMatcher": ["$rustc"],
        "group": {
            "kind": "build",
        },
        "presentation": { "reveal": "always", "focus": true, "panel": "shared" }
      },
      {
        "label": "setup single-node uplink",
        "type": "shell",
        "command": "sudo ${workspaceFolder}/scripts/setup_single_node_uplink.sh",
        "problemMatcher": []
      },
      {
        "label": "remove single-node uplink",
        "type": "shell",
        "command": "sudo ${workspaceFolder}/scripts/setup_single_node_uplink.sh down",
        "problemMatcher": []
      },
      {
        "label": "Run Torii (single-node)",
        "type": "shell",
        "dependsOn": "build ebpf payload",
        // uplink setup and torii share one sudo, so the password is asked only once
        "command": "cargo build --package torii && sudo -E RUST_BACKTRACE=full RUST_LOG=debug INTERNAL_API_KEY=test-internal-api-key CONFIG_FILE=${workspaceFolder}/example_configs/ainari/torii_single_node.toml bash -c '${workspaceFolder}/scripts/setup_single_node_uplink.sh && exec ${workspaceFolder}/target/debug/torii'",
        // torii keeps running, so the task is marked as ready, once its api listens. This allows
        // to use it as preLaunchTask of the compounds in launch.json.
        "isBackground": true,
        "problemMatcher": {
            "base": "$rustc",
            "background": {
                "activeBegin": true,
                "beginsPattern": "^\\s*(Compiling|Finished|Blocking)",
                "endsPattern": "HTTP-server listen internally"
            }
        },
        "group": {
            "kind": "build",
        },
        "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" }
      },
      {
        "label": "Run Torii (single-node, release)",
        "type": "shell",
        // uplink setup and torii share one sudo, so the password is asked only once
        "command": "cargo build --release --package torii && sudo -E RUST_LOG=debug INTERNAL_API_KEY=test-internal-api-key CONFIG_FILE=${workspaceFolder}/example_configs/ainari/torii_single_node.toml bash -c '${workspaceFolder}/scripts/setup_single_node_uplink.sh && exec ${workspaceFolder}/target/release/torii'",
        "isBackground": true,
        "problemMatcher": {
            "base": "$rustc",
            "background": {
                "activeBegin": true,
                "beginsPattern": "^\\s*(Compiling|Finished|Blocking)",
                "endsPattern": "HTTP-server listen internally"
            }
        },
        "group": {
            "kind": "build",
        },
        "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" }
      },
      {
        "label": "Run Neko",
        "type": "shell",
        "command": "cargo build --package neko && sudo -E RUST_BACKTRACE=full RUST_LOG=debug ${workspaceFolder}/target/debug/neko",
        "problemMatcher": ["$rustc"],
        "group": {
            "kind": "build",
        },
        "presentation": { "reveal": "always", "focus": true, "panel": "shared" }
      },
    ],
}
