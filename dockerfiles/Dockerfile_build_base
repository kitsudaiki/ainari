# Image with the toolchain of the rust-components, which dockerfiles/Dockerfile_services is built
# on. It is only nix with the flake of dockerfiles/nix and the development-shell 'services' of it
# already downloaded, so the images of the components don't have to download it again. The
# toolchain itself (rust, protobuf, the libraries of openssl, sqlite and mariadb, ...) is pinned by
# dockerfiles/nix/flake.lock. See docs/developer/docker_images.md.
#
# Build:
#   docker build -f dockerfiles/Dockerfile_build_base -t kitsudaiki/ainari_build_base:0.4.0 .
FROM nixos/nix:2.35.2@sha256:7a007c766426c1877758ddc5cb87a965ac131fc78c582ce0083d922d51ae945c

RUN echo "experimental-features = nix-command flakes" >> /etc/nix/nix.conf

COPY dockerfiles/nix /nix-flake
RUN nix develop path:/nix-flake#services --command true
