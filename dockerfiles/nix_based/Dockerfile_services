# ==========================================
# sakura
# ==========================================
FROM nix AS sakura-rootfs

RUN nix build --no-link path:/nix-flake#runtime-sakura

# The virtual machines are opened through /dev/kvm, which belongs to the group 'kvm' on the host.
# The id of that group differs between hosts, so it can be overwritten at build-time and the
# container gets the id of the host additionally over 'group_add' in the docker-compose-file.
ARG KVM_GID=993

COPY --from=builder /out/sakura /rootfs/home/ainari/sakura
COPY dockerfiles/files/start_sakura.sh /rootfs/home/ainari/start_sakura.sh
RUN /nix-flake/make_rootfs.sh /rootfs runtime-sakura ainari && \
    # Allow the user to create the wireguard-connection
    echo "ainari ALL=(ALL) NOPASSWD: /usr/bin/wg-quick" > /rootfs/etc/sudoers.d/ainari && \
    chmod 0440 /rootfs/etc/sudoers.d/ainari && \
    echo "kvm:x:${KVM_GID}:ainari" >> /rootfs/etc/group && \
    mkdir -p /rootfs/etc/ainari/virtual_machines && \
    chown -R 1000:1000 /rootfs/etc/ainari && \
    chown 1000:1000 /rootfs/home/ainari/sakura /rootfs/home/ainari/start_sakura.sh && \
    chmod +x /rootfs/home/ainari/sakura /rootfs/home/ainari/start_sakura.sh && \
    # The hypervisor and its firmware. The paths are the defaults of the '[hypervisor]'-section
    # of the config of sakura. The hypervisor is copied out of the nix-store, because it gets a
    # capability below, which is not possible within the store.
    cp "$(readlink -f /rootfs/usr/bin/cloud-hypervisor)" /rootfs/usr/local/bin/cloud-hypervisor && \
    ln -s /etc/cloud-hypervisor/CLOUDHV.fd /rootfs/usr/local/share/CLOUDHV.fd

FROM scratch AS sakura

COPY --from=sakura-rootfs /rootfs /
ENV PATH=/usr/local/bin:/usr/bin \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# Attaching a virtual machine to an existing TAP-device is the only privileged operation of this
# container. The capability is given to the hypervisor-binary itself, so neither sakura nor the
# container need to run as root. The container still has to carry CAP_NET_ADMIN in its bounding
# set, which the docker-compose-file does with 'cap_add'.
RUN setcap cap_net_admin+ep /usr/local/bin/cloud-hypervisor

USER ainari
WORKDIR /home/ainari

CMD ["/home/ainari/start_sakura.sh"]
