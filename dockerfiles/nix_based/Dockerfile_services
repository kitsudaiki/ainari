# Images of all rust-components except the torii, which needs another toolchain for its
# eBPF-programs. All binaries are compiled together in one builder-stage, so the dependencies of
# the workspace are only compiled once, and every component has its own runtime-stage, which is
# selected with the target of the build:
#
#   docker build -f dockerfiles/nix_based/Dockerfile_services --target miko \
#       -t kitsudaiki/miko:local_test .
#
# To build a single image faster, the builder can be restricted to its component:
#
#   docker build -f dockerfiles/nix_based/Dockerfile_services --target miko \
#       --build-arg BINARIES=miko ...
#
# The toolchain and all packages of the images come from the flake of dockerfiles/nix_based/nix,
# which pins them in its flake.lock. Every image is built 'FROM scratch' and contains nothing else
# than the packages of its runtime-environment of dockerfiles/nix_based/nix/packages.nix and its
# binary. The list of these packages is in /etc/nix-packages.txt of every image. See
# docs/developer/docker_images.md.

# Image with nix and the toolchain, which is built from dockerfiles/nix_based/Dockerfile_build_base.
# The scripts of the local setups build it locally with this tag, so it doesn't have to be published
# for them.
ARG BUILD_BASE_IMAGE=kitsudaiki/ainari_build_base_nix:0.5.0

# ==========================================
# nix with the flake of this repository
# ==========================================
# The base-image has the flake, with which it was built, but the flake of the repository is always
# the one, which counts. If both are the same, nothing has to be downloaded.
FROM ${BUILD_BASE_IMAGE} AS nix

COPY dockerfiles/nix_based/nix /nix-flake

# ==========================================
# builder of all components
# ==========================================
FROM nix AS builder

RUN nix develop path:/nix-flake#services --command true

WORKDIR /app

COPY Cargo.toml Cargo.toml
COPY Cargo.lock Cargo.lock
COPY src src

# the version-endpoint reports this value, which is read at compile-time. The git-directory
# itself is not copied into the image, because .dockerignore excludes it.
ARG GIT_VERSION=unknown
ENV GIT_VERSION=$GIT_VERSION

# cargo-profile of the build. The local docker-compose-setup uses the faster 'local'-profile.
ARG CARGO_PROFILE=release

# Components, which are compiled. All of them are compiled by default, so the images of all
# components share this stage. A build of a single image, like in the CI, where every image is
# built on its own runner, can restrict it to the component of that image.
ARG BINARIES="miko omamori ryokan onsen hanami sakura"

# The registry and the target-directory are cache-mounts, so they survive between builds and only
# the changed crates are compiled again. The target-directory is not part of the image, so the
# binaries have to be copied out of it within the same step.
#
# The compiled build-scripts and binaries within the cache are linked against the glibc and the
# libraries of the toolchain, which built them. Cargo doesn't notice, when only these change and
# not the version of rustc, and would run build-scripts, which can't be started anymore. So every
# toolchain (the development-shell of the flake, identified by the hash of its store-path) gets
# its own directory within the cache and the directories of all other toolchains are removed.
RUN --mount=type=cache,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,target=/root/.cargo/git,sharing=locked \
    --mount=type=cache,target=/app/target,id=ainari-services-target,sharing=locked \
    TOOLCHAIN="$(nix eval --raw --impure --expr \
        '(builtins.getFlake "path:/nix-flake").devShells.${builtins.currentSystem}.services.outPath' \
        | cut -d/ -f4 | cut -c1-32)" && \
    [ ${#TOOLCHAIN} -eq 32 ] && \
    find /app/target -mindepth 1 -maxdepth 1 ! -name "$TOOLCHAIN" -exec rm -rf {} + && \
    packages="" && \
    for bin in $BINARIES; do packages="$packages -p $bin"; done && \
    nix develop path:/nix-flake#services --command \
        cargo build --target-dir "target/$TOOLCHAIN" --profile "$CARGO_PROFILE" $packages && \
    mkdir -p /out && \
    for bin in $BINARIES; do \
        cp "target/$TOOLCHAIN/$CARGO_PROFILE/$bin" /out/; \
    done

# The development-shell puts all of its libraries into the RUNPATH of every binary, also the ones,
# which the binary doesn't need, like mariadb for onsen. Only the needed ones are kept, so the
# image doesn't need the others.
RUN nix develop path:/nix-flake#services --command sh -c 'patchelf --shrink-rpath /out/*'

# ==========================================
# miko
# ==========================================
FROM nix AS miko-rootfs

# the packages are downloaded before the binary is copied, so a change of the source-code doesn't
# download them again
RUN nix build --no-link path:/nix-flake#runtime-miko

COPY --from=builder /out/miko /rootfs/usr/bin/miko
RUN /nix-flake/make_rootfs.sh /rootfs runtime-miko ainari && \
    mkdir -p /rootfs/etc/ainari && \
    chown 1000:1000 /rootfs/etc/ainari /rootfs/usr/bin/miko && \
    chmod +x /rootfs/usr/bin/miko

FROM scratch AS miko

COPY --from=miko-rootfs /rootfs /
ENV PATH=/usr/local/bin:/usr/bin \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

USER ainari
CMD [ "miko" ]

