# ==========================================
# ryokan
# ==========================================
FROM nix AS ryokan-rootfs

RUN nix build --no-link path:/nix-flake#runtime-ryokan

COPY --from=builder /out/ryokan /rootfs/home/ainari/ryokan
COPY dockerfiles/files/start_ryokan.sh /rootfs/home/ainari/start_ryokan.sh
RUN /nix-flake/make_rootfs.sh /rootfs runtime-ryokan ainari && \
    # Allow the user to create the wireguard-connection. The wg-quick of the image doesn't set
    # 'net.ipv4.conf.all.src_valid_mark', which is not permitted within the pod, see
    # dockerfiles/nix_based/nix/packages.nix.
    echo "ainari ALL=(ALL) NOPASSWD: /usr/bin/wg-quick" > /rootfs/etc/sudoers.d/ainari && \
    chmod 0440 /rootfs/etc/sudoers.d/ainari && \
    mkdir -p /rootfs/etc/ainari && \
    chown 1000:1000 /rootfs/etc/ainari /rootfs/home/ainari/ryokan /rootfs/home/ainari/start_ryokan.sh && \
    chmod +x /rootfs/home/ainari/ryokan /rootfs/home/ainari/start_ryokan.sh

FROM scratch AS ryokan

COPY --from=ryokan-rootfs /rootfs /
ENV PATH=/usr/local/bin:/usr/bin \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

USER ainari
WORKDIR /home/ainari

CMD ["/home/ainari/start_ryokan.sh"]

