# Image of the torii, which is used for every gateway of the network. Which role a gateway has is
# only a question of its config: the gateway at the edge has an uplink, the gateways in front of
# the sakura-hosts have a default-gateway instead.
#
# The toolchain and all packages of the image come from the flake of dockerfiles/nix, which pins
# them in its flake.lock. The image is built 'FROM scratch' and contains nothing else than the
# packages of 'runtime-torii' of dockerfiles/nix/packages.nix and the torii. The list of these
# packages is in /etc/nix-packages.txt of the image. See docs/developer/docker_images.md.

ARG NIX_IMAGE=nixos/nix:2.35.2@sha256:7a007c766426c1877758ddc5cb87a965ac131fc78c582ce0083d922d51ae945c

# ==========================================
# nix with the flake of this repository
# ==========================================
FROM ${NIX_IMAGE} AS nix

RUN echo "experimental-features = nix-command flakes" >> /etc/nix/nix.conf
COPY dockerfiles/nix /nix-flake

# ==========================================
# STAGE 1: Builder
# ==========================================
# The eBPF-programs of the datapath are built with the nightly-toolchain and the bpf-linker of the
# development-shell 'torii'
FROM nix AS builder

RUN nix develop path:/nix-flake#torii --command true

WORKDIR /build

# only the workspace is copied, so a change of the docs or the scripts doesn't rebuild the torii
COPY Cargo.toml Cargo.toml
COPY Cargo.lock Cargo.lock
COPY src src

# cargo-profile of the build. The local docker-compose-setup uses the faster 'local'-profile.
ARG CARGO_PROFILE=release

RUN --mount=type=cache,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,target=/root/.cargo/git,sharing=locked \
    --mount=type=cache,target=/build/target,id=ainari-torii-nix-target,sharing=locked \
    nix develop path:/nix-flake#torii --command cargo build --profile "$CARGO_PROFILE" -p torii && \
    mkdir -p /out && \
    cp "/build/target/$CARGO_PROFILE/torii" /out/

# The eBPF-programs within the torii contain the paths of the sources of the standard-library,
# which are compiled for the bpf-target, as plain text. They are not needed at runtime, but would
# pull the whole toolchain into the image, so the hash of the toolchain is replaced within them.
# Also the libraries, which the torii doesn't need, are removed out of its RUNPATH, which contains
# all libraries of the development-shell.
RUN nix develop path:/nix-flake#torii --command sh -c \
        'remove-references-to -t "$(dirname "$(dirname "$(command -v rustc)")")" /out/torii && \
         patchelf --shrink-rpath /out/torii'

# ==========================================
# STAGE 2: Root-filesystem of the runtime
# ==========================================
FROM nix AS rootfs

# the packages are downloaded before the binary is copied, so a change of the source-code doesn't
# download them again
RUN nix build --no-link path:/nix-flake#runtime-torii

COPY --from=builder /out/torii /rootfs/app/torii
RUN /nix-flake/make_rootfs.sh /rootfs runtime-torii

# ==========================================
# STAGE 3: Minimal Runtime
# ==========================================
FROM scratch

COPY --from=rootfs /rootfs /
ENV PATH=/usr/local/bin:/usr/bin \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

WORKDIR /app

COPY <<'EOF' /app/start.sh
#!/bin/bash

# The uplink of the gateway at the edge is a veth-pair, which is injected into this container by
# scripts/setup_local_stack.sh. Without it the eBPF-programs have nothing to attach to, so the
# gateway waits until the interface is there and carries its address.
if [ -n "$WAIT_FOR_IFACE" ]; then
    echo "Waiting for the host to inject $WAIT_FOR_IFACE ..."
    while ! ip -4 addr show "$WAIT_FOR_IFACE" 2>/dev/null | grep -q "inet "; do sleep 1; done
    ip link set "$WAIT_FOR_IFACE" up
    ethtool -K "$WAIT_FOR_IFACE" tx off rx off

    # The routes of the uplink are programmed with the mac-address of the next hop, which is
    # resolved once, when torii starts. Without an answer to that arp-request every frame towards
    # the host would leave the gateway unaddressed.
    if [ -n "$UPLINK_NEXT_HOP" ]; then
        echo "Resolving the next hop $UPLINK_NEXT_HOP ..."
        for _ in $(seq 1 15); do
            ping -c 1 -W 1 "$UPLINK_NEXT_HOP" > /dev/null 2>&1 && break
            sleep 1
        done
        ip neigh show "$UPLINK_NEXT_HOP" | grep -q lladdr \
            || echo "WARNING: $UPLINK_NEXT_HOP did not answer. Is another interface of the host in the same subnet?"
    fi
fi

# No checksum offloading on the underlay: the datapath rewrites addresses with incremental
# checksum updates, which are only correct on complete checksums.
ethtool -K eth0 tx off rx off

exec /app/torii
EOF

RUN chmod +x /app/start.sh

CMD ["/app/start.sh"]
