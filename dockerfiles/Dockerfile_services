# ==========================================
# ryokan
# ==========================================
FROM debian:12.12-slim@sha256:78d2f66e0fec9e5a39fb2c72ea5e052b548df75602b5215ed01a17171529f706 AS ryokan

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends openssl \
                       curl \
                       libsqlite3-0 \
                       wireguard-tools \
                       iptables-persistent \
                       iproute2 \
                       sudo && \
    apt-get clean autoclean &&\
    apt-get autoremove --yes

# horrible dirty workaround to prevent the error
# sysctl: permission denied on key "net.ipv4.conf.all.src_valid_mark"
# when starting wireguard inside the pod. Didn't found a better solution so far...
RUN sed -i '/src_valid_mark/d' /usr/bin/wg-quick

# Create ainari user and set up directories
RUN useradd -m ainari

# Allow the user to creage the wireguard-connection
RUN echo "ainari ALL=(ALL) NOPASSWD: /usr/bin/wg-quick" >> /etc/sudoers

COPY --from=builder /out/ryokan /home/ainari/ryokan
COPY dockerfiles/files/start_ryokan.sh /home/ainari/start_ryokan.sh
RUN mkdir -p /etc/ainari && \
    chown ainari:ainari /etc/ainari && \
    chown ainari:ainari /home/ainari/ryokan && \
    chown ainari:ainari /home/ainari/start_ryokan.sh && \
    chmod +x /home/ainari/start_ryokan.sh

USER ainari
WORKDIR /home/ainari

CMD ["/home/ainari/start_ryokan.sh"]

