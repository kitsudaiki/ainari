FROM ubuntu:24.04 AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG DEBCONF_NONINTERACTIVE_SEEN=true

WORKDIR /code

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 \
                       python3-pip \
                       python3-venv \
                       ca-certificates && \
    apt-get clean autoclean && \
    apt-get autoremove --yes

RUN python3 -m venv ainari_env && \
    . ainari_env/bin/activate && \
    pip3 install zensical

# CHANGELOG.md and LICENSE have to sit beside the docs-directory, because 'docs/home/CHANGELOG.md'
# and 'docs/home/license.md' are symlinks pointing to them
COPY zensical.toml zensical.toml
COPY CHANGELOG.md CHANGELOG.md
COPY LICENSE LICENSE
COPY docs docs

# 'docs/example_configs' is a symlink to this directory and the '--8<--'-snippets of the
# config-pages reference it relative to this working-directory, so it has to keep the same place
# within the image as it has within the repository
COPY example_configs example_configs

RUN . ainari_env/bin/activate && zensical build --clean

# ---------------------------------------------------

FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 && \
    apt-get clean autoclean && \
    apt-get autoremove --yes

COPY --from=builder /code/site /ainari_docs

RUN chown -R ubuntu:ubuntu /ainari_docs

USER ubuntu
WORKDIR /ainari_docs

EXPOSE 8000

CMD ["python3", "-m", "http.server", "8000"]
