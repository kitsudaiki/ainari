# Image with the toolchain of the rust-components, which dockerfiles/debian_based/Dockerfile_services
# is built on. See docs/developer/build_base_image.md.
#
# Build:
#   docker build -f dockerfiles/debian_based/Dockerfile_build_base \
#       -t kitsudaiki/ainari_build_base_debian:0.5.0 .
#
# Debian 13, because the MariaDB client-library of Debian 12 (Connector/C 3.3.19) returns wrong
# results to diesel. The images of the components use the same version, so the bindings of the
# client-library, which are selected at build-time, match the library at runtime.
FROM debian:13.7-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a

ARG DEBIAN_FRONTEND=noninteractive

RUN set -e && \
        apt-get update && \
        apt-get install --no-install-recommends -y  \
                           protobuf-compiler \
                           gcc \
                           git \
                           curl \
                           pkg-config \
                           libssl-dev \
                           libsqlite3-dev \
                           libmariadb-dev \
                           ca-certificates
RUN curl https://sh.rustup.rs -sSf | sh -s -- -y
